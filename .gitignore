# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets; the template is tracked
.env*
!.env.example

# pocketbase local data and the downloaded binary (make db fetches it)
/pb_data
/tools

# PocketBase auto-generates a JS migration per schema change. The Makefile keeps
# them inside pb_data; this catches any written here by a bare `pocketbase serve`.
# scripts/setup-collections.mjs is the source of truth, not these.
/pb_migrations

# test output
/coverage

# playwright MCP artifacts (snapshots, screenshots, logs)
.playwright-mcp/

# database backups pulled from the deployed volume — real data, never commit
/backups

# railway CLI link state — per-machine, contains project and service ids
.railway

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# role-local working notes — never commit to the shared repo
AGENTS.local.md
ROLE3_PLAN.md
MAINTENANCE_PLAN.md
AI_WORKFLOW.md
PLAN_MEMBER_PUBLISHING.md
docs/TUTORIAL_MEMBER_01.md
CODE_REVIEW_INSTRUCTIONS.md

# review notes
code_review1.md
