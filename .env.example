# ─── 42 Intra OAuth ───────────────────────────────────────────────────────────
# Register the app at: https://profile.intra.42.fr/oauth/applications
# FORTYTWO_REDIRECT_URI must match the callback URL configured there exactly.
NEXT_PUBLIC_42_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ─── PocketBase ───────────────────────────────────────────────────────────────
# Superadmin credentials are server-only — never expose them to the client.
NEXT_PUBLIC_POCKETBASE_URL=https://pocketbase-production-59e1.up.railway.app
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
